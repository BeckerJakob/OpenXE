# Copy to .env in the project root to tune Docker performance (optional).
# docker compose automatically loads .env

# App container (PHP/Apache)
OPENXE_APP_CPUS=4.0
OPENXE_APP_MEM_LIMIT=4g

# MariaDB (give ~50% of Docker Desktop RAM if you have 16GB+ host RAM)
OPENXE_DB_CPUS=4.0
OPENXE_DB_MEM_LIMIT=4g
OPENXE_DB_BUFFER_POOL_SIZE=2048M
OPENXE_DB_BUFFER_POOL_INSTANCES=4
